# Auto detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.py text diff=python eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
